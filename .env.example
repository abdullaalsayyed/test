# GitHub Personal Access Token (required)
# Create one at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_TOKEN=your_github_token_here

# GitHub Organization or User (required)
GITHUB_OWNER=your-org-or-username

# Comma-separated list of repositories to track (optional, defaults to all)
GITHUB_REPOS=repo1,repo2,repo3

# Comma-separated list of team members (GitHub usernames)
TEAM_MEMBERS=user1,user2,user3,user4,user5

# Number of days to track (default: 7)
TRACKING_DAYS=7

# Report format (json, table, html) default: table
REPORT_FORMAT=table

# Output directory for reports (default: ./reports)
OUTPUT_DIR=./reports
